{
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^4.5.0",
    "sharp": "^0.35.5"
  },
  "description": "Newsforge：用 AI Agent 对话式搭建的纯静态新闻聚合站模板。零 API 成本，Cloudflare Pages 托管。",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "name": "newsforge",
  "private": true,
  "scripts": {
    "build": "node pipeline/run.js",
    "build:dry": "node pipeline/run.js --skip-llm",
    "fetch": "node pipeline/run.js --fetch-only",
    "probe": "node pipeline/probe-sources.js",
    "render": "node pipeline/run.js --render-only",
    "test": "python3 pipeline/qa-check.py && node --test pipeline/lib/utils.test.js"
  },
  "type": "module",
  "version": "0.1.0"
}
